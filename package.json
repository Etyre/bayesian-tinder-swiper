{
  "name": "tinder-swiper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local web app that swipes Tinder on your behalf, liking only profiles likely to be vegan/vegetarian or otherwise not subsidizing factory farming.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "playwright": "^1.50.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
